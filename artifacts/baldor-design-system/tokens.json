{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Baldor Specialty Foods design tokens (DTCG). Light = cream editorial surface (default marketing/web). Dark = forest comms canvas (driver postcards, slides, signage). THIS FILE IS THE SINGLE SOURCE OF TRUTH. Edit values here only — do not hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":        { "$value": "#FAF8F3", "$description": "Cream paper surface — the default app/background." },
      "foreground":        { "$value": "#182230", "$description": "Off-black heading text (ink-true)." },
      "border":            { "$value": "#E4E2DB", "$description": "Default 1px border (--border from spec)." },
      "card":              { "$value": "#FFFFFF", "$description": "Elevated card surface (bg-elev / white)." },
      "cardForeground":    { "$value": "#182230" },
      "popover":           { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#182230" },
      "primary": {
        "$value": "#20491D",
        "$description": "Brand primary — green-primary. Drives main CTA buttons. Cream label on top."
      },
      "primaryForeground": { "$value": "#FAF8F3", "$description": "Cream text on dark green." },
      "secondary":         { "$value": "#F1F0EC", "$description": "Cream panel — secondary surface." },
      "secondaryForeground": { "$value": "#344054", "$description": "Ink-muted text on cream panel." },
      "muted":             { "$value": "#F1F0EC" },
      "mutedForeground":   { "$value": "#344054", "$description": "Ink-muted — captions, placeholders, borders." },
      "accent": {
        "$value": "#B3CF44",
        "$description": "Lime — the single loud accent. Numerals, CTA highlights, eyebrow rules."
      },
      "accentForeground":  { "$value": "#182230", "$description": "Dark ink on lime." },
      "destructive":       { "$value": "#E00000", "$description": "Safety/alert red — reserved for safety warnings only." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":             { "$value": "#E4E2DB" },
      "ring":              { "$value": "#007050", "$description": "Focus ring — green-digital." },
      "chart1":            { "$value": "#064725", "$description": "Forest green." },
      "chart2":            { "$value": "#B3CF44", "$description": "Lime." },
      "chart3":            { "$value": "#5C4E71", "$description": "Purple — Featured chip." },
      "chart4":            { "$value": "#79B0C8", "$description": "Sky — Supply Update chip." },
      "chart5":            { "$value": "#F2A813", "$description": "Gold — Local tag / caution." },
      "sidebar":           { "$value": "#FAF8F3" },
      "sidebarForeground": { "$value": "#182230" },
      "sidebarBorder":     { "$value": "#E4E2DB" },
      "sidebarPrimary":    { "$value": "#20491D" },
      "sidebarPrimaryForeground": { "$value": "#FAF8F3" },
      "sidebarAccent":     { "$value": "#F1F0EC" },
      "sidebarAccentForeground": { "$value": "#344054" },
      "sidebarRing":       { "$value": "#007050" }
    },
    "dark": {
      "background":        { "$value": "#20280B", "$description": "Deep-green-black — cover / hero / comms canvas backdrop." },
      "foreground":        { "$value": "#FAF8F3", "$description": "Cream text on dark canvas." },
      "border":            { "$value": "#2D4020", "$description": "Dark green border." },
      "card":              { "$value": "#064725", "$description": "Forest green card surface." },
      "cardForeground":    { "$value": "#FAF8F3" },
      "popover":           { "$value": "#08563F" },
      "popoverForeground": { "$value": "#FAF8F3" },
      "primary": {
        "$value": "#B3CF44",
        "$description": "Lime — the CTA on dark canvas. Max 1–2 loud colors per artifact."
      },
      "primaryForeground": { "$value": "#1E1B1D", "$description": "Dark ink on lime." },
      "secondary":         { "$value": "#08563F", "$description": "Alt dark green — secondary surface." },
      "secondaryForeground": { "$value": "#FAF8F3" },
      "muted":             { "$value": "#064725" },
      "mutedForeground":   { "$value": "#96AB7A", "$description": "Sage — muted text on forest canvas." },
      "accent": {
        "$value": "#F2A813",
        "$description": "Gold — secondary accent on dark canvas (local tag, caution)."
      },
      "accentForeground":  { "$value": "#1E1B1D" },
      "destructive":       { "$value": "#E00000" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":             { "$value": "#2D4020" },
      "ring":              { "$value": "#B3CF44" },
      "chart1":            { "$value": "#B3CF44", "$description": "Lime." },
      "chart2":            { "$value": "#F2A813", "$description": "Gold." },
      "chart3":            { "$value": "#79B0C8", "$description": "Sky." },
      "chart4":            { "$value": "#EE8B84", "$description": "Coral." },
      "chart5":            { "$value": "#5C4E71", "$description": "Purple." },
      "sidebar":           { "$value": "#20280B" },
      "sidebarForeground": { "$value": "#FAF8F3" },
      "sidebarBorder":     { "$value": "#2D4020" },
      "sidebarPrimary":    { "$value": "#B3CF44" },
      "sidebarPrimaryForeground": { "$value": "#1E1B1D" },
      "sidebarAccent":     { "$value": "#064725" },
      "sidebarAccentForeground": { "$value": "#FAF8F3" },
      "sidebarRing":       { "$value": "#B3CF44" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
        "$description": "Body and UI typeface — substitute for proprietary Herbik. Weights 300–700, italic available."
      },
      "serif": {
        "$value": ["Barlow Condensed", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Display / poster typeface — substitute for proprietary Ruder Plakat. Condensed, weights 400–900. Always UPPERCASE for headlines."
      },
      "mono": {
        "$value": ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Accent / kicker typeface — substitute for proprietary FT Polar. Used for pull quotes and section kickers."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base radius = 8px (r-sm). Cards/modals use r-lg = 16px (2×). Buttons use r-sm or pill (9999px)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4pt grid. Scale: 2/4/8/12/16/20/24/32/40/48/64/96px. Never invent values outside this scale."
    }
  }
}
