{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for the Dobeu Tech Solutions design system (DTCG format). THIS FILE IS THE SINGLE SOURCE OF TRUTH. Edit values here only — do not hand-edit the generated src/index.css or src/generated/tokens.tsx. The dev server regenerates them on every change (scripts/build-tokens.mjs). Color roles exist in both light and dark. Dark is the default for developer products (dobeu.dev); light is the default for consumer products (dobeu.net). The CTA swaps: indigo in light, amber in dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FFFFFF", "$description": "Page background — white for consumer light surfaces." },
      "foreground": { "$value": "#2D2D3A", "$description": "Default body text — brand-text-gray." },
      "border": { "$value": "#E0DFF5", "$description": "Default 1px border — brand-border-light (warm indigo tint)." },
      "card": { "$value": "#FFF8F0", "$description": "Card surface — brand-cream-soft." },
      "cardForeground": { "$value": "#2D2D3A" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#2D2D3A" },
      "primary": {
        "$value": "#6B5CE7",
        "$description": "CTA in light mode — brand-indigo-primary. Drives buttons, links, and emphasis. Swaps to amber in dark."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#FFF8F0", "$description": "Secondary surface — brand-cream-soft." },
      "secondaryForeground": { "$value": "#2D2D3A" },
      "muted": { "$value": "#F5F5F7", "$description": "Neutral muted surface — brand-neutral-gray." },
      "mutedForeground": { "$value": "#888888", "$description": "Muted/subdued text in light mode." },
      "accent": { "$value": "#F4A261", "$description": "Amber accent — brand-amber-warm. Rating stars, highlight accents, dark-mode CTA." },
      "accentForeground": { "$value": "#2D2D3A" },
      "destructive": { "$value": "#E07A5F", "$description": "Error / danger — semantic-error." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#E0DFF5", "$description": "Input border — brand-border-light." },
      "ring": { "$value": "#6B5CE7", "$description": "Focus ring — indigo at 22% alpha in practice (shadow-ring-indigo)." },
      "chart1": { "$value": "#6B5CE7", "$description": "Chart: indigo-primary." },
      "chart2": { "$value": "#F4A261", "$description": "Chart: amber-warm." },
      "chart3": { "$value": "#4CAF50", "$description": "Chart: semantic-success green." },
      "chart4": { "$value": "#5A4FAB", "$description": "Chart: indigo-slate." },
      "chart5": { "$value": "#E07A5F", "$description": "Chart: semantic-error coral." },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#2D2D3A" },
      "sidebarBorder": { "$value": "#E0DFF5" },
      "sidebarPrimary": { "$value": "#6B5CE7" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#FFF8F0" },
      "sidebarAccentForeground": { "$value": "#2D2D3A" },
      "sidebarRing": { "$value": "#6B5CE7" }
    },
    "dark": {
      "background": { "$value": "#1A1A2E", "$description": "Page background — brand-dark-surface. Default for dobeu.dev." },
      "foreground": { "$value": "#E0E0E0", "$description": "Default body text in dark — brand-body-text-dark." },
      "border": { "$value": "#2A2A45", "$description": "Default 1px border — brand-border-dark." },
      "card": { "$value": "#242440", "$description": "Card surface — brand-dark-elevated." },
      "cardForeground": { "$value": "#E0E0E0" },
      "popover": { "$value": "#242440" },
      "popoverForeground": { "$value": "#E0E0E0" },
      "primary": {
        "$value": "#F4A261",
        "$description": "CTA in dark mode — brand-amber-warm. The CTA swaps from indigo (light) to amber (dark) for contrast."
      },
      "primaryForeground": { "$value": "#2D2D3A" },
      "secondary": { "$value": "#242440", "$description": "Secondary surface — brand-dark-elevated." },
      "secondaryForeground": { "$value": "#E0E0E0" },
      "muted": { "$value": "#242440", "$description": "Muted surface — dark-elevated." },
      "mutedForeground": { "$value": "#9A9AB0", "$description": "Muted text in dark — fg-muted dark." },
      "accent": { "$value": "#6B5CE7", "$description": "Accent in dark — indigo-primary for secondary actions and highlights." },
      "accentForeground": { "$value": "#FFFFFF" },
      "destructive": { "$value": "#E07A5F", "$description": "Error / danger — semantic-error." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#2A2A45", "$description": "Input border — brand-border-dark." },
      "ring": { "$value": "#F4A261", "$description": "Focus ring in dark — amber (shadow-ring-amber)." },
      "chart1": { "$value": "#6B5CE7" },
      "chart2": { "$value": "#F4A261" },
      "chart3": { "$value": "#4CAF50" },
      "chart4": { "$value": "#5A4FAB" },
      "chart5": { "$value": "#E07A5F" },
      "sidebar": { "$value": "#1A1A2E" },
      "sidebarForeground": { "$value": "#E0E0E0" },
      "sidebarBorder": { "$value": "#2A2A45" },
      "sidebarPrimary": { "$value": "#F4A261" },
      "sidebarPrimaryForeground": { "$value": "#2D2D3A" },
      "sidebarAccent": { "$value": "#242440" },
      "sidebarAccentForeground": { "$value": "#E0E0E0" },
      "sidebarRing": { "$value": "#F4A261" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Nunito", "Quicksand", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Primary UI and body typeface — warm rounded humanist. Weights 400/500/600/700/800. Loaded from Google Fonts."
      },
      "serif": {
        "$value": ["Georgia", "serif"],
        "$description": "Fallback serif — not used in standard Dobeu UI."
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
        "$description": "Code and token values. Used in dev-portal UI and code blocks. Loaded from Google Fonts."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius = 12px (buttons, inputs, avatars). sm derives -4px (6px tags/badges); lg +8px (20px cards/modals); xl +16px (pill = ~28px)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4pt grid. All spacing multiples of this: 4/8/12/16/20/24/32/40/48/64/80px. Card internal padding: 20px. Navbar height: 64px."
    }
  }
}
